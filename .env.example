# Server env (Render sets these; for local runs export them yourself). Never commit real values.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
POST_TOKEN=                 # bearer token for bots (scripts/setup/gen-secrets.sh)
VAPID_PUBLIC_KEY=           # web push keys (scripts/setup/gen-secrets.sh)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=              # optional: mailto:... or https://... (defaults to PUBLIC_URL / RENDER_EXTERNAL_URL)
CHAT_WEBHOOK_URL=           # the chat bot's webhook routine URL
CHAT_WEBHOOK_KEY=           # ...and its key (sent as Bearer + X-Automation-Key)
SUBMISSION_WEBHOOK_URL=     # optional: send lesson submissions to a different bot (defaults to the chat webhook)
SUBMISSION_WEBHOOK_KEY=
PUBLIC_URL=                 # optional: https://your-app.onrender.com (Render provides RENDER_EXTERNAL_URL)
TRUST_PROXY=cloudflare      # cloudflare on Render; none for local
PUSH_DRY_RUN=               # 1 = log pushes instead of sending them (tests)
# Branding overrides (else kit.config.json): KIT_TITLE KIT_SHORT_NAME KIT_STUDENT_NAME KIT_FIELD KIT_ACCENT
# KIT_TIMEZONE KIT_CHAT_BOT KIT_FEEDBACK_BOT KIT_BOTS (JSON array) KIT_CHAT_SUGGESTIONS (JSON array)
